<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lifestylehomecorp</groupId>
        <artifactId>training-bff</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>product-discovery</artifactId>
    <name>product-discovery (domain module)</name>
    <description>
        Store-scoped discovery domain (Session 3): full-text search, category browse, facets and
        the storefront PLP, all via the commercetools Product Search API (GraphQL) in a single
        hydrated call. api/application/domain are fully wired; the infrastructure adapter holds the
        one GraphQL call. Depends on `platform` only.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.lifestylehomecorp</groupId>
            <artifactId>platform</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                    <mainClass>com.lifestylehomecorp.discovery.DiscoveryApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
