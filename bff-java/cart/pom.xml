<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lifestylehomecorp</groupId>
        <artifactId>training-bff</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cart</artifactId>
    <name>cart (domain module)</name>
    <description>
        Cart domain (Session 4 — "Fill the Basket"): the guest cart and its write model — line
        items, bundles, recurring/subscription lines, fulfilment channel, inventory modes, shipping
        address + method, discount codes, and the cart summary. Every write is an update action on a
        stateful cart carrying its current version; the BFF owns version + retry-on-409. Depends on
        `platform` only.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.lifestylehomecorp</groupId>
            <artifactId>platform</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                    <mainClass>com.lifestylehomecorp.cart.CartApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
