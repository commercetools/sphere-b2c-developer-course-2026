# commercetools credentials for the Java BFF. Copy to `.env` (gitignored) and fill in.
# spring-dotenv reads `.env` into the Spring Environment at startup.

CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret

# Region endpoints (example: europe-west1 GCP). CTP_AUTH_URL is the auth host;
# the app appends /oauth/token itself.
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com

# Optional: in-store key for store-scoped endpoints (leave blank if unused).
CTP_STORE_KEY=

# Training progress tracking.
# Your participant identity is derived AUTOMATICALLY from your API client's NAME — so name your API
# client like "firstname_lastname_api" when you create it. Reading the name needs the
# `manage_api_clients` scope; if the client lacks it, the id falls back to your clientId and
# PARTICIPANT_NAME (below) is used as the display name.
PARTICIPANT_NAME=Your Name
# Progress store: "ct" (commercetools Custom Object, default) or "memory" (local, no persistence).
TRAINING_PROGRESS_STORE=ct
